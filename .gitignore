# ===============
# Training output (auto-generated; large)
# ===============
# Original MAPPO per-run output (under onpolicy/scripts/):
/onpolicy/scripts/results/
**/win_rate/

# ===============
# Logs (per-run training stdout; large)
# ===============
# Default location for run-time logs (per MAPPO convention):
/onpolicy/scripts/**/logs/
/onpolicy/**/runner/**/logs/

# ===============
# Curated experiment results (TRACK THESE — they are our paper data)
# ===============
# IMPORTANT: results/ at repo root IS tracked because it contains our
# curated logs, auto-generated curves, and figures. Don't ignore it.
!results/
!results/**

